<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DeadlockOfRain</AssemblyName>
    <RootNamespace>DeadlockOfRain</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <RoR2Dir Condition="'$(RoR2Dir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Risk of Rain 2</RoR2Dir>
    <Managed>$(RoR2Dir)\Risk of Rain 2_Data\Managed</Managed>
    <BepCore>$(RoR2Dir)\BepInEx\core</BepCore>
    <NoWarn>CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(BepCore)\BepInEx.dll" Private="false" />
    <Reference Include="$(BepCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(Managed)\RoR2.dll" Private="false" />
    <Reference Include="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Managed)\HGCSharpUtils.dll" Private="false" />
    <Reference Include="$(Managed)\HGUnityUtils.dll" Private="false" />
    <Reference Include="$(Managed)\KinematicCharacterController.dll" Private="false" />
    <Reference Include="$(Managed)\Rewired_Core.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.Addressables.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(Managed)\com.unity.multiplayer-hlapi.Runtime.dll" Private="false" />
    <Reference Include="$(Managed)\EOS.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\discord.png" LogicalName="DeadlockOfRain.discord.png" />
  </ItemGroup>
</Project>
